+                tq: torch.Tensor,
+                tk: torch.Tensor,
+                tv: torch.Tensor,
+                mask_type: int,
+                max_seq_len: int,
+                silu_value: float,
+                seq_offset: Optional[List[int]],
+                attn_bias: Optional[torch.Tensor] = None,
+                mask: Optional[torch.Tensor] = None,
+                ) -> torch.Tensor:
+        import sysconfig
+        torch.npu.config.allow_internal_format = False
+        torch.ops.load_library(f"{sysconfig.get_path('purelib')}/libfbgemm_npu_api.so")
+        return torch.ops.mxrec.hstu_dense(
+            tq.view(-1, self.num_heads, self.attention_dim),
+            tk.view(-1, self.num_heads, self.attention_dim),
+            tv.view(-1, self.num_heads, self.linear_dim),
+            mask,
+            attn_bias,
+            0 if self.is_causal else mask_type,
+            max_seq_len,
+            silu_value,
+            "jagged",
+            seq_offset).view(-1, self.num_heads * self.attention_dim)
 
