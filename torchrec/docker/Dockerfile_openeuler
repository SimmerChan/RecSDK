# 阶段1：基础环境准备
FROM openeuler-22.03-lts-sp4:latest AS base
WORKDIR /tmp
COPY ./version.info ./
COPY ./ascend_install.info ./

# 更新证书和安装基础工具
RUN dnf install -y ca-certificates && \
    dnf makecache && \
    dnf -y install \
        net-tools make wget unzip zlib-devel bzip2 bzip2-devel openssl-devel \
        ncurses-devel openssh-clients openssh-server sqlite-devel openmpi-devel \
        readline-devel tk-devel gdbm-devel libdb-devel xz-devel libffi-devel \
        hdf5-devel patch pciutils vim findutils dos2unix gcc-c++ automake \
        autoconf m4 perl git e2fsprogs sudo util-linux && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# 阶段2：下载源码
FROM base AS downloader
RUN wget https://mirrors.huaweicloud.com/gnu/gcc/gcc-11.2.0/gcc-11.2.0.tar.gz && \
    tar -zxvf gcc-11.2.0.tar.gz && \
    cd gcc-11.2.0 && \
    wget https://mirrors.huaweicloud.com/gnu/gmp/gmp-6.1.0.tar.bz2 && \
    wget https://mirrors.huaweicloud.com/gnu/mpfr/mpfr-3.1.6.tar.bz2 && \
    wget https://mirrors.huaweicloud.com/gnu/mpc/mpc-1.0.3.tar.gz && \
    wget https://gcc.gnu.org/pub/gcc/infrastructure/isl-0.18.tar.bz2 && \
    cd .. && \
    wget https://cmake.org/files/v3.22/cmake-3.22.6.tar.gz && \
    wget https://mirrors.huaweicloud.com/python/3.11.0/Python-3.11.0.tar.xz && \
    wget https://download.pytorch.org/whl/cpu/torch-2.6.0%2Bcpu-cp311-cp311-manylinux_2_28_aarch64.whl && \
    wget https://download.pytorch.org/whl/cpu/fbgemm_gpu-1.1.0%2Bcpu-cp311-cp311-manylinux2014_aarch64.whl && \
    rm -rf /tmp/gcc-11.2.0.tar.gz

# 阶段3：编译工具链
FROM base AS builder
COPY --from=downloader /tmp/gcc-11.2.0 /tmp/gcc-11.2.0
COPY --from=downloader /tmp/cmake-3.22.6.tar.gz /tmp/
COPY --from=downloader /tmp/Python-3.11.0.tar.xz /tmp/

# 编译 GCC 11.2.0
RUN cd /tmp/gcc-11.2.0 && \
    sed -i "246s/tar -xf \"\${ar}\"/tar --no-same-owner -xf \"\${ar}\"/" contrib/download_prerequisites && \
    ./contrib/download_prerequisites && \
    ./configure --enable-languages=c,c++ --disable-multilib --with-system-zlib --prefix=/usr/local/gcc11.2.0 && \
    make -j $(nproc) && make install && \
    find /tmp/gcc-11.2.0/ -name libstdc++.so.6.0.29 -exec cp {} /lib64/ \; && \
    rm -rf /tmp/gcc-11.2.0*

# 编译 CMake
RUN tar -zxf /tmp/cmake-3.22.6.tar.gz && \
    cd cmake-3.22.6 && \
    ./bootstrap && make -j $(nproc) && make install && \
    rm -rf /tmp/cmake-3.22.6*

# 编译 Python 3.11.0
RUN tar -xvf /tmp/Python-3.11.0.tar.xz && \
    cd Python-3.11.0 && \
    mkdir -p build && cd build && \
    ../configure --enable-shared --prefix=/usr/local/python3.11.0 && \
    make -j $(nproc) && make install && \
    rm -rf /tmp/Python-3.11.0*

# 阶段4：安装 Python 包
FROM base AS python-packages
COPY --from=downloader /tmp/*.whl /tmp/
COPY --from=builder /usr/local/python3.11.0 /usr/local/python3.11.0

ENV PATH=/usr/local/python3.11.0/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/python3.11.0/lib:$LD_LIBRARY_PATH

# 配置 pip 源
RUN mkdir -p ~/.pip && \
    echo "[global]" > ~/.pip/pip.conf && \
    echo "index-url = https://pypi.tuna.tsinghua.edu.cn/simple" >> ~/.pip/pip.conf && \
    echo "extra-index-url = https://mirrors.aliyun.com/pypi/simple" >> ~/.pip/pip.conf && \
    echo "               https://repo.huaweicloud.com/repository/pypi/simple" >> ~/.pip/pip.conf && \
    echo "trusted-host = pypi.tuna.tsinghua.edu.cn mirrors.aliyun.com repo.huaweicloud.com" >> ~/.pip/pip.conf && \
    echo "timeout = 600" >> ~/.pip/pip.conf && \
    echo "retries = 3" >> ~/.pip/pip.conf

# 安装 Python 包（合并命令）
RUN pip3.11 install --upgrade pip && \
    pip3.11 install \
        numpy==1.25.0 wheel decorator sympy==1.13.1 cffi==1.17.1 \
        expecttest pybind11 pyyaml psutil pathlib2 pandas==2.2.3 \
        grpcio grpcio-tools==1.67.0 protobuf==5.28.2 scipy==1.14.1 requests \
        scikit-learn easydict attrs pytest pytest-cov pytest-html \
        Cython absl-py gin-config torch-2.6.0+cpu-*.whl fbgemm_gpu-1.1.0+cpu-*.whl \
        torch-npu==2.6.0.rc1 tensorboard==2.18.0 black cmake hypothesis==6.70.1 \
        iopath pyre-extensions scikit-build torchmetrics==1.0.3 torchx tqdm usort && \
    rm -rf /root/.cache/pip

# 阶段5：最终镜像
FROM openeuler-22.03-lts-sp4:latest
WORKDIR /tmp
COPY --from=builder /usr/local/gcc11.2.0 /usr/local/gcc11.2.0
COPY --from=builder /usr/local/bin/cmake /usr/local/bin/cmake
COPY --from=python-packages /usr/local/python3.11.0 /usr/local/python3.11.0
COPY --from=python-packages /root/.pip /root/.pip
COPY ./Ascend-cann-toolkit_*.run ./
COPY ./Ascend-cann-kernels-*.run ./

# 设置环境变量
ENV PATH=/usr/local/gcc11.2.0/bin:/usr/local/python3.11.0/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/gcc11.2.0/lib64:/usr/local/python3.11.0/lib:$LD_LIBRARY_PATH

# 安装 Ascend Toolkit
ARG ASCEND_BASE=/usr/local/Ascend
RUN umask 0022 && mkdir -p $ASCEND_BASE && \
    chmod +x Ascend-cann-toolkit_*.run && \
    ./Ascend-cann-toolkit_*.run --quiet --install --install-path=$ASCEND_BASE && \
    chmod +x Ascend-cann-kernels-*.run && \
    ./Ascend-cann-kernels-*.run --quiet --install && \
    rm -f Ascend-cann-*.run && \
    pip3.11 install torch_npu-2.6.0-cp311-cp311-*whl && \
    rm -rf /root/.cache/pip /tmp/*

# 验证
RUN gcc --version && cmake --version && python3.11 --version